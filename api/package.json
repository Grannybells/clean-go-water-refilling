{
  "name": "api",
  "version": "1.0.0",
  "description": "Express TypeScript MySQL API with JWT, CORS, Helmet, and rate limiting",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:init": "ts-node src/scripts/initDatabase.ts",
    "db:drop": "ts-node -r dotenv/config src/scripts/dropTables.ts",
    "db:reset": "npm run db:drop && npm run db:init && npm run seed:modules && npm run seed:users && npm run seed:stations",
    "seed:owner": "ts-node -r dotenv/config src/scripts/seedOwner.ts",
    "seed:users": "ts-node -r dotenv/config src/scripts/seedUsers.ts",
    "seed:stations": "ts-node -r dotenv/config src/scripts/seedStations.ts",
    "seed:modules": "ts-node -r dotenv/config src/scripts/seedModules.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
