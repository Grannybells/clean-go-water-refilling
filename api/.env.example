PORT=3000
NODE_ENV=development

DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=main-database
DB_USER=sa
DB_PASSWORD=

JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# Used once by `npm run seed:owner` to bootstrap the first owner.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=Owner
SEED_OWNER_LAST_NAME=Account

# Shared password for all 8 users created by `npm run seed:users`.
SEED_USERS_PASSWORD=changeme123
