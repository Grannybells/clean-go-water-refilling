PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=main-database

JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Used once by `npm run seed:owner` to bootstrap the first owner.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=Owner
SEED_OWNER_LAST_NAME=Account

# Shared password for all 8 users created by `npm run seed:users`.
SEED_USERS_PASSWORD=changeme123
